# Contact form
CONTACT_RECEIVER_EMAIL=

# ERP / Nexus CMS — public read-only API. Leave CMS_API_URL empty to disable
# the integration entirely (the site then renders exactly as without it).
CMS_API_URL=https://apierp.clickmasters.pk
CMS_SITE_DOMAIN=clickmastersblockchaintechnologies.com

# Origin of the ERP visual editor; added to CSP frame-ancestors so the editor
# can load this site in its preview frame. Empty = no framing (X-Frame-Options SAMEORIGIN).
CMS_EDITOR_ORIGIN=https://erp.clickmasters.pk

# Apply the ERP site colors to created pages (default: keep the site's own palette).
CMS_USE_ERP_COLORS=false

# Live updates: how often open tabs check the ERP for new publishes (ms). 0 = off.
NEXT_PUBLIC_CMS_LIVE_POLL_MS=15000
